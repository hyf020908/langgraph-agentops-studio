# HTTP_PROXY=
# HTTPS_PROXY=

APP_NAME=LangGraph AgentOps Studio
LOG_LEVEL=INFO
OUTPUT_ROOT=runs
CHECKPOINT_MODE=memory
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_SEARCH_RESULTS=5
MAX_RETRIES=2
MAX_REVISIONS=2
RISK_THRESHOLD_FOR_HUMAN_REVIEW=0.68
DEFAULT_REVIEWER=governance-board
ENABLE_LANGSMITH=false
LANGSMITH_PROJECT=langgraph-agentops-studio

# Optional MCP connections (API and workers must share OUTPUT_ROOT and settings).
MCP_ENABLED=false
MCP_ALLOW_STDIO=false
# Comma-separated executable names/paths; use absolute paths for stdio servers.
MCP_ALLOWED_COMMANDS=
# Only these environment variables may be referenced by server credentials/env.
MCP_ALLOWED_ENV_VARS=
MCP_TIMEOUT=30
MCP_MAX_OUTPUT_CHARS=32000
MCP_MAX_TOOLS=64

# LLM provider configuration
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2200
LLM_TIMEOUT=60
LLM_EXTRA_HEADERS_JSON={}
LLM_EXTRA_KWARGS_JSON={}

# Embedding provider configuration
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
EMBEDDING_EXTRA_HEADERS_JSON={}
EMBEDDING_EXTRA_KWARGS_JSON={}

# Vector DB / RAG configuration
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentops_knowledge
QDRANT_LOCAL_PATH=.qdrant

# Milvus (used when VECTOR_DB_PROVIDER=milvus)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=agentops_knowledge

# Weaviate (used when VECTOR_DB_PROVIDER=weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=AgentOpsKnowledge
WEAVIATE_GRPC_HOST=
WEAVIATE_GRPC_PORT=
WEAVIATE_GRPC_SECURE=

# Chroma (leave CHROMA_HOST empty for local persistent storage)
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_HEADERS_JSON={}
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_PATH=.chroma
CHROMA_COLLECTION=agentops_knowledge

# pgvector (used when VECTOR_DB_PROVIDER=pgvector)
PGVECTOR_DSN=
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=agentops_knowledge

# Pinecone (used when VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=agentops-knowledge
PINECONE_NAMESPACE=agentops
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

VECTOR_DB_TIMEOUT=30
RAG_ENABLED=true
RAG_SOURCE_DIR=knowledge_base
RAG_TOP_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SCORE_THRESHOLD=

# Web grounding mode and providers
WEB_SEARCH_MODE=auto
WEB_SEARCH_PROVIDER=
WEB_READER_PROVIDER=
ENABLE_WEB_SEARCH=false
ENABLE_VECTOR_RAG=true
WEB_SEARCH_TOP_K=5
WEB_READER_TOP_K=3
EVIDENCE_MERGE_STRATEGY=score

# Tavily search
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_MAX_RESULTS=5
TAVILY_INCLUDE_RAW_CONTENT=false

# Jina Reader
JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai/
JINA_READER_TIMEOUT=30
JINA_READER_JSON=false
JINA_READER_BYPASS_CACHE=false

# Exa search + contents
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_SEARCH_TYPE=neural
EXA_MAX_RESULTS=5
EXA_USE_CONTENTS=true

# Governance policy thresholds
GOVERNANCE_OVERALL_RISK_THRESHOLD=0.65
GOVERNANCE_RECOMMENDATION_CONFIDENCE_THRESHOLD=0.62
GOVERNANCE_EVIDENCE_COMPLETENESS_THRESHOLD=0.55
GOVERNANCE_CONTRADICTION_SEVERITY_THRESHOLD=0.55
GOVERNANCE_UNRESOLVED_QUESTIONS_THRESHOLD=2
GOVERNANCE_HIGH_STAKES_TASK_CATEGORIES=architecture,security,finance
GOVERNANCE_MANUAL_APPROVAL_POLICY_BY_TASK_TYPE_JSON={}

# Context compaction
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_MAX_ESTIMATED_TOKENS=24000
CONTEXT_LIGHT_PRESSURE_RATIO=0.60
CONTEXT_HIGH_PRESSURE_RATIO=0.75
CONTEXT_CRITICAL_PRESSURE_RATIO=0.85
CONTEXT_RECENT_USER_MESSAGES=2
CONTEXT_RECENT_MESSAGES=8
CONTEXT_TRACE_TAIL_SIZE=25
CONTEXT_SEMANTIC_DEDUPE_THRESHOLD=0.90
CONTEXT_TOOL_OFFLOAD_ENABLED=true
CONTEXT_SUMMARY_MAX_CALLS=8

# Deterministic report/conclusion depth
REPORT_DETAIL_LEVEL=detailed
REPORT_MAX_FINDINGS_IN_CONCLUSION=5
REPORT_MAX_EVIDENCE_IN_CONCLUSION=6
REPORT_MAX_RISKS_IN_CONCLUSION=5
REPORT_INCLUDE_NEXT_ACTIONS=true
# Execution and bounded queue admission (compose overrides mode to rabbitmq)
TASK_QUEUE_MODE=inline
MAX_CONCURRENT_RUNS=8
MAX_PENDING_JOBS=1000
RABBITMQ_URL=amqp://agentops:change-me@127.0.0.1:5672/%2F
RABBITMQ_USER=agentops
RABBITMQ_PASSWORD=change-me
RABBITMQ_QUEUE=agentops.runs

# Hybrid retrieval: vector + persistent BM25 -> RRF -> rerank
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_PATH=runs/bm25.sqlite
RAG_CANDIDATE_K=30
RAG_RRF_K=60
# lexical = local coverage heuristic; http = learned rerank service; none = RRF only
RAG_RERANK_PROVIDER=lexical
RAG_RERANK_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TIMEOUT=10
